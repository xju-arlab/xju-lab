{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xju-arlab.github.io/xju-lab/contracts/printer-protocol-v1.schema.json",
  "title": "XJU Lab Printer Status Agent Protocol v1",
  "type": "object",
  "required": ["agentVersion", "deviceState", "tonerSupported"],
  "properties": {
    "agentVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "deviceState": { "enum": ["READY", "BUSY", "PAPER_OUT", "JAMMED", "ERROR", "UNKNOWN"] },
    "tonerSupported": { "type": "boolean" },
    "tonerPercent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }
  },
  "additionalProperties": false
}