# Local development only. Replace every value before using Compose outside a private machine.
POSTGRES_PASSWORD=local-db-password-change-me
REDIS_PASSWORD=local-redis-password-change-me
REDIS_HOST_PORT=16379
OBJECT_STORE_ACCESS_KEY=local-object-store
OBJECT_STORE_SECRET_KEY=local-object-store-password-change-me
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-change-me
S3_ENDPOINT=http://object-store:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=local-object-store
S3_SECRET_KEY=local-object-store-password-change-me
S3_BUCKET=xju-lab-private
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@localhost
APPROVAL_TOKEN_ENCRYPTION_KEY=local-only-key-change-this-32-characters
PROMETHEUS_URL=
PROMETHEUS_BEARER_TOKEN=
METRIC_STALE_AFTER_SECONDS=90
OJ_PUBLIC_ORIGIN=https://oj.icthub.top
OJ_BASE_URL=
OJ_SERVICE_TOKEN=

# Production app profile requirements. Do not use local Keycloak values in production.
OIDC_ISSUER_URI=https://identity.example.invalid/application/o/xju-lab/
OIDC_CLIENT_ID=replace-with-production-client-id
OIDC_CLIENT_SECRET=replace-with-production-client-secret
LAB_FRONTEND_ORIGIN=https://lab.example.edu
