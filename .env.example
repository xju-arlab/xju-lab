# Local development only. Replace every value before using Compose outside a private machine.
POSTGRES_PASSWORD=local-db-password-change-me
REDIS_PASSWORD=local-redis-password-change-me
REDIS_HOST_PORT=16379
OBJECT_STORE_ACCESS_KEY=local-object-store
OBJECT_STORE_SECRET_KEY=local-object-store-password-change-me
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-change-me
S3_ENDPOINT=http://object-store:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=local-object-store
S3_SECRET_KEY=local-object-store-password-change-me
S3_BUCKET=xju-lab-private
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=no-reply@localhost
APPROVAL_TOKEN_ENCRYPTION_KEY=local-only-key-change-this-32-characters
PROMETHEUS_URL=
# Fixed read-only HP status endpoint: https://hp.icthub.top/v1/status
# Keep disabled in local/CI environments; enable only when binding this printer.
HP_PRINTER_STATUS_ENABLED=false
PROMETHEUS_BEARER_TOKEN=
METRIC_STALE_AFTER_SECONDS=90
OJ_PUBLIC_ORIGIN=https://oj.icthub.top
OJ_BASE_URL=
OJ_SERVICE_TOKEN=

# Production app profile requirements. Authentik must allow self-registration, verify email ownership, and return email_verified=true.
# Register callback URI https://lab.icthub.top/login/oauth2/code/lab. Ordinary members require verified @icthub.top addresses.
# The exact bootstrap issuer + subject may use an existing verified email from another domain.
OIDC_ISSUER_URI=https://auth.icthub.top/application/o/replace-with-provider-slug/
OIDC_CLIENT_ID=replace-with-production-client-id
OIDC_CLIENT_SECRET=replace-with-production-client-secret
BOOTSTRAP_ADMIN_ISSUER=https://auth.icthub.top/application/o/replace-with-provider-slug/
BOOTSTRAP_ADMIN_SUBJECT=replace-with-exact-oidc-sub
# Any verified email; existing OJ unified identities can also sign in.
PRODUCT_REGISTRATION_DOMAIN=*
LAB_FRONTEND_ORIGIN=https://lab.icthub.top

# Directory containing a readable SSH `config` file; mounted read-only into the app.
# Use a dedicated directory; do not mount personal private keys. Empty default catalog is valid.
LAB_SSH_CONFIG_DIR=./ssh-config

# Only the image build network. Use host when Docker's build proxy listens on host loopback.
# Application containers always remain on the private Compose network.
LAB_BUILD_NETWORK=default
