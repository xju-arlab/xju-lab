{
  "realm": "xju-lab",
  "enabled": true,
  "displayName": "XJU Lab Local Test IdP",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "groups": [{ "name": "lab-members" }],
  "clients": [{
    "clientId": "lab-dev",
    "name": "XJU Lab local application",
    "enabled": true,
    "clientAuthenticatorType": "client-secret",
    "secret": "lab-dev-secret",
    "standardFlowEnabled": true,
    "directAccessGrantsEnabled": false,
    "redirectUris": ["http://localhost:8080/login/oauth2/code/lab", "http://localhost:18080/login/oauth2/code/lab"],
    "webOrigins": ["http://localhost:8080", "http://localhost:18080"],
    "protocol": "openid-connect",
    "attributes": { "pkce.code.challenge.method": "S256" },
    "protocolMappers": [{
      "name": "groups",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-group-membership-mapper",
      "consentRequired": false,
      "config": { "full.path": "false", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true", "claim.name": "groups" }
    }, {
      "name": "icthub_account_id",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-attribute-mapper",
      "consentRequired": false,
      "config": { "user.attribute": "icthub_account_id", "claim.name": "icthub_account_id", "jsonType.label": "String", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true" }
    }]
  }],
  "users": [
    { "id": "00000000-0000-4000-8000-000000000101", "username": "local-admin", "enabled": true, "email": "local-admin@example.test", "firstName": "Local", "lastName": "Admin", "emailVerified": true, "attributes": { "icthub_account_id": ["local-admin"] }, "groups": ["lab-members"], "credentials": [{ "type": "password", "value": "local-admin-change-me", "temporary": false }] },
    { "id": "00000000-0000-4000-8000-000000000102", "username": "local-member-a", "enabled": true, "email": "local-member-a@example.test", "firstName": "Local", "lastName": "Member A", "emailVerified": true, "attributes": { "icthub_account_id": ["local-member-a"] }, "groups": ["lab-members"], "credentials": [{ "type": "password", "value": "local-member-a-change-me", "temporary": false }] },
    { "id": "00000000-0000-4000-8000-000000000103", "username": "local-member-b", "enabled": true, "email": "local-member-b@example.test", "firstName": "Local", "lastName": "Member B", "emailVerified": true, "attributes": { "icthub_account_id": ["local-member-b"] }, "groups": ["lab-members"], "credentials": [{ "type": "password", "value": "local-member-b-change-me", "temporary": false }] }
  ]
}
