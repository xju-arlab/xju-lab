{
  "name": "xju-lab-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "vite --mode demo --host 0.0.0.0 --port 5173 --strictPort",
    "dev:api": "vite --mode api --host 0.0.0.0 --port 5173 --strictPort",
    "api:types": "openapi-typescript ../contracts/openapi.yaml -o src/api/openapi.d.ts",
    "build": "pnpm api:types && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:assessment": "node --experimental-strip-types --test tests/assessment.test.ts",
    "test:seats": "node tests/seats.test.mjs",
    "test:cache": "node --experimental-strip-types --test tests/query-cache.test.ts",
    "test:e2e": "playwright test",
    "export:floor-plan": "node scripts/export-floor-plan.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10.4.20",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.6.3",
    "vite": "8.3.1"
  }
}
